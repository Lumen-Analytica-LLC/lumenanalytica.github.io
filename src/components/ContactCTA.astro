---
import { bookingHref, CONTACT, contactHref, type Industry } from '../config/contact';
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';

interface Props {
	/** Pre-selects the industry on the contact form. */
	industry?: Industry;
	/** Attach the demo scenario the visitor is looking at (its current URL) to their message. */
	captureScenario?: boolean;
	title?: string;
}

const { industry, captureScenario = false, title = 'Want a twin of your operation?' } = Astro.props;
const from = captureScenario ? 'demo' : undefined;
---

<aside data-contact-cta={captureScenario ? industry ?? 'other' : undefined}>
	<h2>{title}</h2>
	<div class="actions">
		<CallToAction href={bookingHref(industry, from)}>
			{CONTACT.bookingUrl ? 'Book a 20-minute call' : 'Talk to us'}
			<Icon icon="arrow-right" size="1.2em" />
		</CallToAction>
		{
			CONTACT.bookingUrl && (
				<a class="secondary" href={contactHref(industry, from)}>
					Or send a message
				</a>
			)
		}
	</div>
</aside>

<script>
	import { HANDOFF_KEY, type Industry } from '../config/contact';

	// On demo pages, carry the scenario the visitor set up through to the contact form.
	for (const cta of document.querySelectorAll<HTMLElement>('[data-contact-cta]')) {
		cta.addEventListener('click', (event) => {
			if (!(event.target as Element).closest('a[href^="/contact/"]')) return;
			try {
				sessionStorage.setItem(
					HANDOFF_KEY,
					JSON.stringify({ industry: cta.dataset.contactCta as Industry, scenario: location.href }),
				);
			} catch {
				// Storage unavailable: the form still works, just without the scenario attached.
			}
		});
	}
</script>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 18ch;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem 1.5rem;
	}

	.secondary {
		font-weight: 600;
		color: var(--gray-100);
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
