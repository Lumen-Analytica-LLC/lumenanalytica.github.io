---
import '../../twin/twin-theme.css';
import '../../twin/twin-ui.css';
import { DEFAULT_CONFIG, DISRUPTION_WINDOW, formatClock, MAX_PROVIDERS, MAX_ROOMS, TEMPLATES } from '../../twin/scenarios/clinic/model';

const speeds = [
	{ value: 3, label: '3×' },
	{ value: 8, label: '8×' },
	{ value: 15, label: '15×' },
	{ value: 30, label: '30×' },
];
const defaultSpeed = 8;

const kpis = [
	{ key: 'avgWait', label: 'Avg wait to provider' },
	{ key: 'p90Wait', label: '90th percentile wait' },
	{ key: 'waiting', label: 'In the waiting room' },
	{ key: 'lwbs', label: 'Left without being seen' },
	{ key: 'utilization', label: 'Provider utilization' },
	{ key: 'finish', label: 'Last patient out' },
];

const legend = [
	{ token: 'ok', label: 'Waiting < 15 min' },
	{ token: 'warn', label: '15–30 min' },
	{ token: 'bad', label: '30+ min' },
	{ token: 'seen', label: 'Seen by provider' },
	{ token: 'provider', label: 'Provider' },
	{ token: 'assistant', label: 'Medical assistant' },
	{ token: 'clerk', label: 'Front desk' },
];

const roomLegend = [
	{ token: 'rooming', label: 'Rooming' },
	{ token: 'ready', label: 'Waiting for provider' },
	{ token: 'visit', label: 'With provider' },
	{ token: 'cleaning', label: 'Turnover' },
];

const [awayStart, awayEnd] = DISRUPTION_WINDOW.map(formatClock);
---

<section class="twin twin-theme" data-clinic-twin aria-label="Clinic digital twin simulation">
	<div class="toolbar">
		<div class="clock" aria-label="Simulated time">
			<span class="clock-label">Clinic time</span>
			<span class="clock-value" data-clock>7:30 AM</span>
		</div>
		<div class="transport">
			<button type="button" class="btn btn-primary" data-play aria-pressed="true">
				<span data-label>Pause</span>
			</button>
			<button type="button" class="btn" data-restart>Restart day</button>
			<button type="button" class="btn" data-new-day title="Same settings, a different day of patients">New day</button>
		</div>
	</div>

	<div class="layout">
		<div class="stage">
			<div class="floor-wrap">
				<canvas data-floor role="img" aria-label="Top-down floor plan of the clinic with patients and staff moving between the front desk, waiting room and exam rooms"></canvas>
			</div>
			<ul class="legend" aria-label="People">
				{
					legend.map((item) => (
						<li>
							<span class="swatch" style={`background: var(--twin-${item.token})`} />
							{item.label}
						</li>
					))
				}
			</ul>
			<ul class="legend legend-rooms" aria-label="Exam room status">
				<li class="legend-title">Exam room light:</li>
				{
					roomLegend.map((item) => (
						<li>
							<span class="swatch" style={`background: var(--twin-${item.token})`} />
							{item.label}
						</li>
					))
				}
			</ul>

			<div class="panel">
				<header class="panel-header">
					<h2>Provider availability</h2>
					<ul class="legend legend-inline" aria-label="Board legend">
						<li><span class="swatch swatch-booked"></span>Booked</li>
						<li><span class="swatch" style="background: var(--twin-visit)"></span>With patient</li>
						<li><span class="swatch swatch-charting"></span>Charting</li>
						<li><span class="swatch swatch-away"></span>Away</li>
					</ul>
				</header>
				<canvas data-board class="board" role="img" aria-label="Timeline per provider comparing booked appointments with actual patient time, charting and time away"></canvas>
			</div>
		</div>

		<aside class="side">
			<div class="kpis" aria-live="off">
				{
					kpis.map((kpi) => (
						<div class="kpi" data-kpi={kpi.key} data-tone="neutral">
							<span class="kpi-label">{kpi.label}</span>
							<span class="kpi-value" data-value>–</span>
							<span class="kpi-sub" data-sub />
						</div>
					))
				}
			</div>

			<div class="summary" data-summary role="status" hidden>
				<strong>Day complete.</strong>
				<span data-summary-text></span>
			</div>

			<form class="panel controls" data-controls>
				<h2>What if…</h2>
				<p class="hint">Changes replay the day up to now with the same patients, so you see only the effect of your change.</p>

				<label class="field">
					<span class="field-row"><span>Providers</span><output for="ct-providers"></output></span>
					<input id="ct-providers" name="providers" type="range" min="2" max={MAX_PROVIDERS} step="1" value={DEFAULT_CONFIG.providers} />
				</label>

				<label class="field">
					<span class="field-row"><span>Exam rooms</span><output for="ct-rooms"></output></span>
					<input id="ct-rooms" name="rooms" type="range" min="3" max={MAX_ROOMS} step="1" value={DEFAULT_CONFIG.rooms} />
				</label>

				<fieldset class="field">
					<legend>Appointment template</legend>
					<div class="segmented">
						{
							Object.entries(TEMPLATES).map(([value, template]) => (
								<label>
									<input type="radio" name="template" value={value} checked={value === DEFAULT_CONFIG.template} />
									<span>{template.label}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<label class="field">
					<span class="field-row"><span>Double-booked slots</span><output for="ct-db" data-suffix="%"></output></span>
					<input id="ct-db" name="doubleBookPct" type="range" min="0" max="30" step="5" value={DEFAULT_CONFIG.doubleBookPct} />
				</label>

				<label class="field">
					<span class="field-row"><span>No-show rate</span><output for="ct-ns" data-suffix="%"></output></span>
					<input id="ct-ns" name="noShowPct" type="range" min="0" max="30" step="2" value={DEFAULT_CONFIG.noShowPct} />
				</label>

				<label class="field">
					<span class="field-row"><span>Walk-ins per hour</span><output for="ct-wi"></output></span>
					<input id="ct-wi" name="walkInsPerHour" type="range" min="0" max="6" step="0.5" value={DEFAULT_CONFIG.walkInsPerHour} />
				</label>

				<label class="check">
					<input name="disruption" type="checkbox" checked={DEFAULT_CONFIG.disruption} />
					<span>Pull Dr. Patel away {awayStart}–{awayEnd}</span>
				</label>

				<fieldset class="field">
					<legend>Playback speed</legend>
					<div class="segmented">
						{
							speeds.map((speed) => (
								<label>
									<input type="radio" name="speed" value={speed.value} checked={speed.value === defaultSpeed} />
									<span>{speed.label}</span>
								</label>
							))
						}
					</div>
				</fieldset>
			</form>

			<div class="panel">
				<h2>Events</h2>
				<ol class="log" data-log></ol>
			</div>
		</aside>
	</div>
</section>

<script>
	import { mountClinicTwin } from '../../twin/scenarios/clinic/app';

	for (const root of document.querySelectorAll<HTMLElement>('[data-clinic-twin]')) mountClinicTwin(root);
</script>
