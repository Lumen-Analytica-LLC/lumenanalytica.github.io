---
import '../../twin/twin-theme.css';

interface Props {
	/** Where "open the full twin" points. */
	href?: string;
}

const { href = '/healthcare/demo/' } = Astro.props;
---

<figure class="preview twin-theme" data-clinic-preview>
	<div class="screen">
		<canvas data-floor role="img" aria-label="Animated floor plan of a simulated clinic: patients checking in, waiting, and seeing providers in exam rooms"></canvas>
	</div>
	<figcaption class="stats">
		<div class="badge">
			<span class="live" aria-hidden="true"></span>
			<span data-clock>8:00 AM</span>
		</div>
		<div><span class="value" data-stat="waiting">–</span><span class="label">in waiting room</span></div>
		<div><span class="value" data-stat="avgWait">–</span><span class="label">avg wait</span></div>
		<div><span class="value" data-stat="seen">–</span><span class="label">patients seen</span></div>
		<a href={href} class="open">Open the full twin →</a>
	</figcaption>
</figure>

<script>
	import { mountClinicPreview } from '../../twin/scenarios/clinic/preview';

	for (const root of document.querySelectorAll<HTMLElement>('[data-clinic-preview]')) mountClinicPreview(root);
</script>

<style>
	.preview {
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.screen {
		border-radius: 1.25rem;
		overflow: hidden;
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-lg);
		background: var(--twin-bg);
	}

	canvas {
		display: block;
		width: 100%;
		aspect-ratio: 518 / 292;
	}

	.badge {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.7rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-800);
		font-weight: 600;
		color: var(--gray-100);
		font-variant-numeric: tabular-nums;
		align-self: center;
	}

	.live {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--twin-ok);
		animation: pulse 1.6s ease-in-out infinite;
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live {
			animation: none;
		}
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.stats > div:not(.badge) {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.value {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		font-variant-numeric: tabular-nums;
	}

	.open {
		margin-left: auto;
		color: var(--accent-dark);
		font-weight: 600;
		text-decoration: none;
	}

	.open:hover {
		text-decoration: underline;
	}
</style>
