---
import '../../twin/twin-theme.css';
import '../../twin/twin-ui.css';
import { langFromPath } from '../../i18n';
import { COLD_TEXT } from '../../i18n/twins';
import { MAX_FORKLIFTS, MAX_INBOUND_DOORS } from '../../twin/scenarios/cold-storage/layout';
import {
	DEFAULT_CONFIG,
	EXCURSION_MINUTES,
	FORKLIFTS_DOWN_WINDOW,
	formatClock,
	OPEN,
	PATTERNS,
	PRIORITIES,
} from '../../twin/scenarios/cold-storage/model';

const lang = langFromPath(Astro.url.pathname);
const t = COLD_TEXT[lang];

const speeds = [
	{ value: 3, label: '3×' },
	{ value: 8, label: '8×' },
	{ value: 15, label: '15×' },
	{ value: 30, label: '30×' },
];
const defaultSpeed = 8;

const kpis = Object.entries(t.kpis).map(([key, label]) => ({ key, label }));

const legend = [
	{ token: 'ok', label: t.legend.ok(EXCURSION_MINUTES / 2) },
	{ token: 'warn', label: t.legend.warn(EXCURSION_MINUTES / 2, EXCURSION_MINUTES) },
	{ token: 'bad', label: t.legend.bad(EXCURSION_MINUTES) },
	{ token: 'precool', label: t.legend.precool },
	{ token: 'hold', label: t.legend.hold },
	{ token: 'cold', label: t.legend.cold },
	{ token: 'mild', label: t.legend.mild },
];

const truckLegend = [
	{ token: 'truck-in', label: t.legend.inbound },
	{ token: 'truck-out', label: t.legend.outbound },
	{ token: 'forklift', label: t.legend.forklift },
];

const [downStart, downEnd] = FORKLIFTS_DOWN_WINDOW.map((time) => formatClock(time, lang));
---

<section class="twin twin-theme" data-cold-storage-twin data-lang={lang} aria-label={t.aria}>
	<div class="toolbar">
		<div class="clock">
			<span class="clock-label">{t.clockLabel}</span>
			<span class="clock-value" data-clock>{formatClock(OPEN, lang)}</span>
		</div>
		<div class="transport">
			<button type="button" class="btn btn-primary" data-play aria-pressed="true">
				<span data-label>{t.pause}</span>
			</button>
			<button type="button" class="btn" data-restart>{t.restart}</button>
			<button type="button" class="btn" data-new-day title={t.newDayTitle}>{t.newDay}</button>
		</div>
	</div>

	<div class="layout">
		<div class="stage">
			<div class="floor-wrap">
				<canvas data-floor style="aspect-ratio: 660 / 352" role="img" aria-label={t.floorAria}></canvas>
			</div>
			<ul class="legend" aria-label={t.legend.pallets}>
				<li class="legend-title">{t.legend.pallets}</li>
				{
					legend.map((item) => (
						<li>
							<span class="swatch" style={`background: var(--twin-${item.token}); border-radius: 0.2rem`} />
							{item.label}
						</li>
					))
				}
			</ul>
			<ul class="legend legend-rooms" aria-label={t.legend.vehicles}>
				<li class="legend-title">{t.legend.vehicles}</li>
				{
					truckLegend.map((item) => (
						<li>
							<span class="swatch" style={`background: var(--twin-${item.token})`} />
							{item.label}
						</li>
					))
				}
				<li class="legend-title">{t.legend.stripe}</li>
			</ul>

			<div class="panel">
				<header class="panel-header">
					<h2>{t.board.title}</h2>
					<ul class="legend legend-inline">
						<li><span class="swatch" style="background: var(--twin-truck-in)"></span>{t.board.inbound}</li>
						<li><span class="swatch" style="background: var(--twin-truck-out)"></span>{t.board.outbound}</li>
						<li><span class="swatch" style="background: var(--twin-bad)"></span>{t.board.detention}</li>
					</ul>
				</header>
				<canvas data-board class="board" role="img" aria-label={t.boardAria}></canvas>
			</div>
		</div>

		<aside class="side">
			<div class="kpis" aria-live="off">
				{
					kpis.map((kpi) => (
						<div class="kpi" data-kpi={kpi.key} data-tone="neutral">
							<span class="kpi-label">{kpi.label}</span>
							<span class="kpi-value" data-value>–</span>
							<span class="kpi-sub" data-sub />
						</div>
					))
				}
			</div>

			<div class="summary" data-summary role="status" hidden>
				<strong>{t.dayComplete}</strong>
				<span data-summary-text></span>
			</div>

			<form class="panel controls" data-controls>
				<h2>{t.whatIf}</h2>
				<p class="hint">{t.hint}</p>

				<label class="field">
					<span class="field-row"><span>{t.controls.forklifts}</span><output for="cs-forklifts"></output></span>
					<input id="cs-forklifts" name="forklifts" type="range" min="3" max={MAX_FORKLIFTS} step="1" value={DEFAULT_CONFIG.forklifts} />
				</label>

				<label class="field">
					<span class="field-row"><span>{t.controls.doors}</span><output for="cs-doors"></output></span>
					<input id="cs-doors" name="doors" type="range" min="3" max={MAX_INBOUND_DOORS} step="1" value={DEFAULT_CONFIG.doors} />
				</label>

				<label class="field">
					<span class="field-row"><span>{t.controls.trucks}</span><output for="cs-trucks"></output></span>
					<input id="cs-trucks" name="trucksPerDay" type="range" min="15" max="55" step="1" value={DEFAULT_CONFIG.trucksPerDay} />
				</label>

				<fieldset class="field">
					<legend>{t.controls.arrivals}</legend>
					<div class="segmented">
						{
							Object.keys(PATTERNS).map((value) => (
								<label>
									<input type="radio" name="pattern" value={value} checked={value === DEFAULT_CONFIG.pattern} />
									<span>{t.patterns[value as keyof typeof t.patterns]}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class="field">
					<legend>{t.controls.priority}</legend>
					<div class="segmented">
						{
							Object.keys(PRIORITIES).map((value) => (
								<label>
									<input type="radio" name="priority" value={value} checked={value === DEFAULT_CONFIG.priority} />
									<span>{t.priorities[value as keyof typeof t.priorities]}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<label class="field">
					<span class="field-row"><span>{t.controls.inspection}</span><output for="cs-inspect" data-suffix="%"></output></span>
					<input id="cs-inspect" name="inspectionPct" type="range" min="0" max="40" step="5" value={DEFAULT_CONFIG.inspectionPct} />
				</label>

				<label class="field">
					<span class="field-row"><span>{t.controls.precool}</span><output for="cs-precool"></output></span>
					<input id="cs-precool" name="precoolCapacity" type="range" min="24" max="96" step="8" value={DEFAULT_CONFIG.precoolCapacity} />
				</label>

				<label class="check">
					<input name="surge" type="checkbox" checked={DEFAULT_CONFIG.surge} />
					<span>{t.controls.surge}</span>
				</label>

				<label class="check">
					<input name="forkliftsDown" type="checkbox" checked={DEFAULT_CONFIG.forkliftsDown} />
					<span>{t.controls.down(downStart, downEnd)}</span>
				</label>

				<fieldset class="field">
					<legend>{t.speed}</legend>
					<div class="segmented">
						{
							speeds.map((speed) => (
								<label>
									<input type="radio" name="speed" value={speed.value} checked={speed.value === defaultSpeed} />
									<span>{speed.label}</span>
								</label>
							))
						}
					</div>
				</fieldset>
			</form>

			<div class="panel">
				<h2>{t.events}</h2>
				<ol class="log" data-log></ol>
			</div>
		</aside>
	</div>
</section>

<script>
	import { mountColdStorageTwin } from '../../twin/scenarios/cold-storage/app';

	for (const root of document.querySelectorAll<HTMLElement>('[data-cold-storage-twin]')) mountColdStorageTwin(root);
</script>
