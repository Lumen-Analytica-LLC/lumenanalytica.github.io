---
import { langFromPath, localizePath, UI } from '../../i18n';
import '../../twin/twin-theme.css';

type Scenario = 'clinic' | 'cold-chain';

interface Props {
	scenario: Scenario;
	/** Where "open the full twin" points. Defaults to the scenario's demo page. */
	href?: string;
}

const lang = langFromPath(Astro.url.pathname);
const es = lang === 'es';

const SCENARIOS: Record<Scenario, { href: string; aspect: string; label: string; stats: { key: string; label: string }[] }> = {
	clinic: {
		href: '/healthcare/demo/',
		aspect: '518 / 292',
		label: es
			? 'Plano animado de una clínica simulada: pacientes que se registran, esperan y pasan con su médico en los consultorios'
			: 'Animated floor plan of a simulated clinic: patients checking in, waiting, and seeing providers in exam rooms',
		stats: [
			{ key: 'waiting', label: es ? 'en sala de espera' : 'in waiting room' },
			{ key: 'avgWait', label: es ? 'espera prom.' : 'avg wait' },
			{ key: 'seen', label: es ? 'pacientes atendidos' : 'patients seen' },
		],
	},
	'cold-chain': {
		href: '/cold-chain/demo/',
		aspect: '660 / 352',
		label: es
			? 'Vista animada de un cross-dock de producto fresco simulado: camiones en fila y en los andenes mientras los montacargas mueven tarimas al preenfriado, la cámara fría y el cuarto templado'
			: 'Animated view of a simulated produce cross-dock: trucks queuing and docking while forklifts move pallets into pre-cool, the cooler and the mild room',
		stats: [
			{ key: 'yard', label: es ? 'camiones en el patio' : 'trucks in yard' },
			{ key: 'detention', label: es ? 'demoras' : 'detention' },
			{ key: 'excursions', label: es ? 'tarimas calientes' : 'warm pallets' },
		],
	},
};

const { scenario } = Astro.props;
const config = SCENARIOS[scenario];
const href = Astro.props.href ?? localizePath(config.href, lang);
---

<figure class="preview twin-theme" data-twin-preview={scenario} data-lang={lang}>
	<div class="screen">
		<canvas data-floor role="img" style={`aspect-ratio: ${config.aspect}`} aria-label={config.label}></canvas>
	</div>
	<figcaption class="stats">
		<div class="badge">
			<span class="live" aria-hidden="true"></span>
			<span data-clock>–</span>
		</div>
		{
			config.stats.map((stat) => (
				<div>
					<span class="value" data-stat={stat.key}>–</span>
					<span class="label">{stat.label}</span>
				</div>
			))
		}
		<a href={href} class="open">{UI[lang].preview.open}</a>
	</figcaption>
</figure>

<script>
	import { mountClinicPreview } from '../../twin/scenarios/clinic/preview';
	import { mountColdStoragePreview } from '../../twin/scenarios/cold-storage/preview';

	for (const root of document.querySelectorAll<HTMLElement>('[data-twin-preview]')) {
		const lang = root.dataset.lang === 'es' ? 'es' : 'en';
		if (root.dataset.twinPreview === 'cold-chain') mountColdStoragePreview(root, lang);
		else mountClinicPreview(root, lang);
	}
</script>

<style>
	.preview {
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.screen {
		border-radius: 1.25rem;
		overflow: hidden;
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-lg);
		background: var(--twin-bg);
	}

	canvas {
		display: block;
		width: 100%;
	}

	.badge {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.7rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-800);
		font-weight: 600;
		color: var(--gray-100);
		font-variant-numeric: tabular-nums;
		align-self: center;
	}

	.live {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--twin-ok);
		animation: pulse 1.6s ease-in-out infinite;
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live {
			animation: none;
		}
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.stats > div:not(.badge) {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.value {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		font-variant-numeric: tabular-nums;
	}

	.open {
		margin-left: auto;
		color: var(--accent-dark);
		font-weight: 600;
		text-decoration: none;
	}

	.open:hover {
		text-decoration: underline;
	}
</style>
