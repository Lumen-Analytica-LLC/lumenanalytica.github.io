---
import CallToAction from '../../components/CallToAction.astro';
import Icon from '../../components/Icon.astro';
import TwinPreview from '../../components/twin/TwinPreview.astro';
import RoiCalculator from '../../components/twin/RoiCalculator.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/industry.css';

const email = 'insights@lumen-analytica.io';
const assessmentHref = `mailto:${email}?subject=${encodeURIComponent('Clinic digital twin assessment')}&body=${encodeURIComponent(
	'Hello,\n\nWe would like to learn more about a digital twin for our clinic.\n\nName:\nOrganization:\nNumber of providers / sites:\nBiggest scheduling or wait-time challenge:\n',
)}`;

const problems = [
	{
		title: 'The waiting room is full by 10 a.m.',
		body: 'Front-loaded templates and double-booking stack patients up early, and the day never recovers.',
	},
	{
		title: 'Providers are idle, then slammed',
		body: 'Quiet first slots, a mid-morning crush, and rooms sitting full of patients waiting on the same provider.',
	},
	{
		title: 'Walk-ins give up and leave',
		body: 'Every patient who walks out is lost revenue, and a patient who may not come back.',
	},
	{
		title: 'The day runs past close',
		body: 'Overtime for front desk, MAs and providers becomes the norm, and so does burnout.',
	},
];

const steps = [
	{
		title: 'Mirror',
		body: 'We build a model of your clinic from your own scheduling and visit-timestamp data: rooms, providers, templates, arrival patterns and visit lengths.',
	},
	{
		title: 'Test',
		body: 'Your team tries changes on the twin first: new templates, staffing, room assignments or walk-in policies. Every scenario replays the same day, so comparisons are fair.',
	},
	{
		title: 'Act',
		body: 'You get the changes worth making, with the expected effect on wait times, throughput and overtime, and a way to check the result after rollout.',
	},
];

const scenarios = [
	{ question: 'What if we switch from hourly blocks to a staggered template?', href: '/healthcare/demo/?t=staggered' },
	{ question: 'What happens when a provider gets pulled away mid-morning?', href: '/healthcare/demo/?d=1&at=0945' },
	{ question: 'Can we absorb a walk-in surge without losing patients?', href: '/healthcare/demo/?wi=5' },
	{ question: 'Is another exam room worth it?', href: '/healthcare/demo/?r=8' },
	{ question: 'What does double-booking actually cost us?', href: '/healthcare/demo/?db=30' },
	{ question: 'Do we need another provider, or a better schedule?', href: '/healthcare/demo/?p=5' },
];

const pilot = [
	{ week: 'Week 1', title: 'Connect', body: 'Kickoff, then a de-identified extract of appointments and visit timestamps. Most EHR and practice management systems can export this as a standard report.' },
	{ week: 'Week 2', title: 'Build and calibrate', body: 'We build the twin of your clinic and check it against a few real days until waits and throughput match what actually happened.' },
	{ week: 'Week 3', title: 'Test with your team', body: 'Working sessions with your operations leads to try the changes you have been debating, plus a few you have not.' },
	{ week: 'Week 4', title: 'Readout', body: 'Recommended changes, expected impact, and a simple plan to measure the result after rollout. You keep the twin.' },
];

const faqs = [
	{
		q: 'Do we need to install new software?',
		a: 'No. The pilot runs on data exports and a hosted twin your team can open in a browser. Nothing touches your EHR.',
	},
	{
		q: 'What data do you need?',
		a: 'Appointment schedules and visit timestamps (check-in, roomed, provider in, checkout) for a few representative weeks, plus your room and staffing setup. We ask for the minimum needed and prefer de-identified extracts.',
	},
	{
		q: 'How is this different from a dashboard?',
		a: 'A dashboard shows what already happened. A twin lets you see what would happen if you changed something, before you change it.',
	},
	{
		q: 'Does it work for urgent care, specialty clinics or hospital departments?',
		a: 'Yes. Anywhere patients arrive, wait and compete for rooms and providers. Urgent care, imaging, infusion centers and emergency department fast-track all follow the same pattern.',
	},
];
---

<BaseLayout
	title="Clinic Digital Twins | Lumen Analytica"
	description="Digital twins for clinics and hospital departments. Test schedule, staffing and room changes on a live model of your clinic before you make them."
>
	<div class="industry stack gap-20 lg:gap-48">
		<header class="wrapper hero">
			<div class="hero-copy stack gap-8">
				<p class="eyebrow">Digital twins for healthcare operations</p>
				<h1>Shorter waits. Fuller days. Fewer late nights.</h1>
				<p class="lede">
					We build a working model of your clinic, a digital twin, so you can test schedule, staffing and room
					changes before you make them, and know what they'll do to wait times and throughput.
				</p>
				<div class="actions">
					<CallToAction href="/healthcare/demo/">
						Try the clinic twin
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
					<a class="secondary" href={assessmentHref}>Book a twin assessment</a>
				</div>
			</div>
			<TwinPreview scenario="clinic" />
		</header>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section">
				<header class="section-header">
					<h2>Sound familiar?</h2>
					<p>Most clinic bottlenecks aren't a staffing problem. They come from how the day is scheduled.</p>
				</header>
				<ul class="cards cards-4">
					{
						problems.map((problem) => (
							<li class="card">
								<h3>{problem.title}</h3>
								<p>{problem.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section">
				<header class="section-header">
					<h2>How a clinic twin works</h2>
					<p>A dashboard tells you what happened. A twin shows you what would happen.</p>
				</header>
				<ol class="cards cards-3 steps">
					{
						steps.map((step, i) => (
							<li class="card">
								<span class="step-number">{i + 1}</span>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
							</li>
						))
					}
				</ol>
			</section>

			<section class="section">
				<header class="section-header">
					<h2>Questions you can answer before Monday</h2>
					<p>Each one opens the demo twin with that change applied. The same patients, the same day: only your change is different.</p>
				</header>
				<ul class="scenarios">
					{
						scenarios.map((scenario) => (
							<li>
								<a href={scenario.href}>
									<span>{scenario.question}</span>
									<Icon icon="arrow-right" size="1.1em" />
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section" id="roi">
				<header class="section-header">
					<h2>What's a shorter day worth?</h2>
					<p>Put in your own numbers for a rough annual estimate. The pilot replaces these assumptions with measured results.</p>
				</header>
				<RoiCalculator model="clinic" email={email} />
			</section>

			<section class="section">
				<header class="section-header">
					<h2>A 30-day pilot</h2>
					<p>One clinic, one month, a fixed scope. You finish with a calibrated twin and a short list of changes worth making.</p>
				</header>
				<ol class="timeline">
					{
						pilot.map((item) => (
							<li class="card">
								<span class="week">{item.week}</span>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</li>
						))
					}
				</ol>
			</section>

			<section class="section">
				<header class="section-header">
					<h2>Common questions</h2>
				</header>
				<div class="faqs">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<aside class="closing">
			<h2>See your clinic's day before it happens</h2>
			<p>Tell us about your clinic and the problem you'd most like to solve. We'll show you what a twin of it would look like.</p>
			<div class="actions">
				<CallToAction href={assessmentHref}>
					Book a twin assessment
					<Icon icon="paper-plane-tilt" size="1.2em" />
				</CallToAction>
				<a class="secondary" href="/healthcare/demo/">Try the demo first</a>
			</div>
		</aside>
	</div>
</BaseLayout>
